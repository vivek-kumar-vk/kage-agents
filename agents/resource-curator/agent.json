{
  "name": "Kage Resource Curator",
  "role": "specialist",
  "reportsTo": "Kage Learning Head",
  "adapterType": "hermes_local",
  "adapterConfig": {
    "model": "claude-sonnet-4-6",
    "effort": "medium",
    "graceSec": 15,
    "timeoutSec": 0,
    "maxTurnsPerRun": 50,
    "dangerouslySkipPermissions": true,
    "instructionsEntryFile": "AGENTS.md",
    "instructionsBundleMode": "managed",
    "paperclipSkillSync": {
      "desiredSkills": [],
      "syncMode": "ephemeral"
    }
  },
  "runtimeConfig": {
    "heartbeat": {
      "enabled": true,
      "intervalSec": 600,
      "wakeOnAssignment": true,
      "wakeOnOnDemand": true,
      "wakeOnAutomation": true
    },
    "aiConnection": { "mode": "responsible_user", "method": "subscription", "provider": "anthropic" },
    "debug": { "providerTrace": "raw" }
  },
  "budgetMonthlyCents": 2500,
  "permissions": { "canCreateAgents": false, "canCreateSkills": true }
}